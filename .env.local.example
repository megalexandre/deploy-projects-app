# Copie este arquivo para .env.local e ajuste os valores
# O .env.local NÃO é commitado (coberto por *.local no .gitignore)

# URL base da API (use /api para proxy via Vite em dev)
VITE_API_BASE_URL=/api

# Alvo do proxy — requisições /api/* serão redirecionadas aqui
VITE_API_PROXY_TARGET=https://www.projetosopjengenharia.com.br

# Chave do localStorage para o token de autenticação
VITE_AUTH_TOKEN_STORAGE_KEY=auth_token

# URL base do serviço ViaCEP
VITE_VIACEP_BASE_URL=https://viacep.com.br/ws
